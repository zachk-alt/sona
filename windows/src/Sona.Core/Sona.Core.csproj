<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same NAudio.Core that NAudio.Wasapi pulls into the app: the speech audio conversion lives here so it is tested off Windows. -->
    <PackageReference Include="NAudio.Core" Version="2.4.0" />
  </ItemGroup>
</Project>
