<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Sona</AssemblyName>
    <ApplicationIcon>../../assets/Sona.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Retired Assistant code is excluded from the dictation-only app. -->
    <Compile Remove="AssistantActionExecutor.cs;AssistantCursor.cs;AssistantUserActivity.cs;AssistantPanel.cs;AssistantSettingsWindow.cs;WindowContext.cs;SessionActivity.cs" />
    <ProjectReference Include="../Sona.Core/Sona.Core.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <!-- sherpa-onnx (Apache-2.0) runs Parakeet for English. Only its managed binding comes from NuGet. The NuGet runtime's
         sherpa-onnx-c-api.dll also carries text to speech with espeak-ng (GPL-3.0-or-later) linked in, so its native files
         are excluded here. build.ps1 downloads the official no-TTS build of the same version (sherpa-onnx-c-api.dll and
         onnxruntime.dll), checks its pinned SHA-256, and passes its folder in as SherpaNativeDirectory. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" ExcludeAssets="native" />
    <None Include="../../../Resources/Sounds/*.wav" Link="sounds/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../../LICENSE" Link="SONA-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../docs/licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="../../assets/Sona.ico" Link="Assets/Sona.ico" />
    <Resource Include="../../../Resources/SonaAppIcon.png" Link="Assets/SonaAppIcon.png" />
    <Resource Include="../../../Resources/MenuIconRecording.png" Link="Assets/MenuIconRecording.png" />
    <None Include="../../../bridge/*.mjs;../../../bridge/*.json;../../../bridge/README.md" Exclude="../../../bridge/blender.mjs;../../../bridge/blender-scene.py" Link="bridge/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../../bridge/prompts/*.txt" Link="bridge/prompts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgWhisper_net_Runtime)/build/win-x64/*.dll" Link="runtimes/win-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgWhisper_net_Runtime_NoAvx)/build/win-x64/*.dll" Link="runtimes/noavx/win-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- The verified no-TTS native pair, supplied by build.ps1. Without it the app still builds, and English falls back to Whisper. -->
  <ItemGroup Condition="'$(SherpaNativeDirectory)' != ''">
    <Content Include="$(SherpaNativeDirectory)/sherpa-onnx-c-api.dll;$(SherpaNativeDirectory)/onnxruntime.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- Native sidecars are explicitly selected above so package build targets cannot bundle the wrong platform. -->
  <!-- sherpa-onnx's native pair stays beside Sona.exe, like Whisper's, so onnxruntime.dll loads from the app folder. -->
  <!-- A sherpa-onnx-c-api.dll from any NuGet package is dropped from publish, so only the no-TTS build can ship. -->
  <Target Name="KeepSherpaNativeBesideApp" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'sherpa-onnx-c-api.dll' And '%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'sherpa-onnx-c-api.dll' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- License gate: publish fails if the shipped sherpa-onnx-c-api.dll carries espeak-ng (the text to speech build). -->
  <Target Name="RefuseSherpaWithEspeak" AfterTargets="Publish">
    <PropertyGroup>
      <_SonaPublishedSherpa>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', 'sherpa-onnx-c-api.dll'))</_SonaPublishedSherpa>
      <_SonaSherpaHasEspeak Condition="Exists('$(_SonaPublishedSherpa)')">$([System.IO.File]::ReadAllText('$(_SonaPublishedSherpa)').Contains('espeak_ng_'))</_SonaSherpaHasEspeak>
    </PropertyGroup>
    <Error Condition="'$(_SonaSherpaHasEspeak)' == 'True'" Text="The published sherpa-onnx-c-api.dll contains espeak_ng_ (GPL-3.0-or-later text to speech). Ship the no-TTS build from build.ps1 instead." />
  </Target>
</Project>
